{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://human-not-found.example/schemas/extension-manifest.schema.json",
  "title": "Human Not Found Extension Bundle Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bundle_id",
    "version",
    "contract_version",
    "description",
    "digest",
    "permissions",
    "components"
  ],
  "properties": {
    "bundle_id": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "Person or group who wrote the package, shown in Explore."
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-fA-F0-9]{64}$"
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "read_shared_state",
          "read_private_actions",
          "read_private_state",
          "write_state",
          "model_call",
          "artifact_read",
          "emit_event",
          "external_network"
        ]
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "family",
          "entrypoint",
          "description",
          "config_schema"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$"
          },
          "family": {
            "enum": [
              "agent",
              "mechanic",
              "procedure",
              "evaluator"
            ]
          },
          "entrypoint": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "config_schema": {
            "type": "object"
          },
          "about": {
            "type": "object",
            "additionalProperties": false,
            "description": "Plain-language description shown on the component's page. Every field is optional.",
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300,
                "description": "One sentence: what the component does."
              },
              "how_it_works": {
                "type": "string",
                "minLength": 1,
                "maxLength": 3000,
                "description": "A short paragraph on how it behaves during a run."
              },
              "actions": {
                "type": "array",
                "maxItems": 16,
                "description": "What participants can do (activities and flows).",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "description"
                  ],
                  "properties": {
                    "type": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    }
                  }
                }
              },
              "ends_when": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300,
                "description": "When the step ends (activities and flows)."
              },
              "outputs": {
                "type": "array",
                "maxItems": 16,
                "description": "What a measurement reports.",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "label",
                    "description"
                  ],
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    },
                    "unit": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 60
                    }
                  }
                }
              }
            }
          }
        }
      },
      "minItems": 1
    }
  }
}
